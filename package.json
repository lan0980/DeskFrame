{
  "name": "deskframe",
  "version": "1.0.0",
  "description": "Desktop beautification framework for Windows: the host provides loading, rendering, layout, configuration, lifecycle and fault isolation; widgets decide what your desktop looks like. Ships with 8 ready-to-use widgets.",
  "private": true,
  "main": "host/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "validate:widgets": "node scripts/validate-widgets.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.deskframe.host",
    "productName": "DeskFrame",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "host/**/*",
      "widgets/**/*",
      "!widgets/_template/**",
      "!widgets/README.md",
      "!widgets/*/README.md",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "DeskFrame-win-x64.exe",
      "requestExecutionLevel": "user"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lan0980/DeskFrame.git"
  },
  "author": "lan0980",
  "license": "MIT",
  "keywords": [
    "desktop",
    "widget",
    "beautification",
    "windows",
    "electron"
  ]
}
