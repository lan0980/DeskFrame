{
  "name": "deskframe",
  "version": "0.1.0",
  "description": "Desktop beautification framework: host provides loading, layout, config, lifecycle and fault isolation; widgets are written by users.",
  "private": true,
  "main": "host/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --dir",
    "validate:widgets": "node scripts/validate-widgets.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.deskframe.host",
    "productName": "DeskFrame",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "host/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
